# Copy to .env and edit. Never commit real secrets.

# ---- LLM (optional: if empty, the stack runs in deterministic OFFLINE mode) ----
OPENAI_API_KEY=sk-replace_me_dummy_value
OPENAI_BASE_URL=
LLM_MODEL_ID=gpt-4o-mini

# ---- Embeddings for the baseline vector RAG ----
# "local" = deterministic hashing embeddings (no network); "openai" = hosted embeddings
EMBEDDING_BACKEND=local
EMBEDDING_MODEL_ID=text-embedding-3-small
TOP_K=3

# ---- Neo4j ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_please

# ---- API server ----
API_PORT=8000
API_BASE_URL=http://localhost:8000
DATASET_PATH=data/dataset.json
AUTO_INGEST=true
